#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 32, local_size_y = 1) in;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint stride_words;
    uint grid_cols;
    uint grid_rows;
    uint tile_size;
    uint dirty_tile_count;
} pc;

layout(std430, binding = 0) readonly buffer CurrentFrame {
    uint curr_pixels[];
};

layout(std430, binding = 1) readonly buffer DirtyList {
    uint in_dirty_count;
    uint dirty_tile_ids[];
};

layout(std430, binding = 2) buffer PacketMeta {
    uint total_packet_bytes;
};

layout(std430, binding = 3) writeonly buffer PacketOutput {
    uint8_t packet_data[];
};

// 33 and 41 strides eliminate all 32-way and 8-way LDS bank conflicts
shared uint s_tile_pixels[32 * 33];
shared uint s_row_comp[32 * 41];
shared uint s_row_len[32];
shared uint s_row_offset[32];
shared uint s_tile_payload_len;
shared uint s_out_pos;
shared uint s_comp_type;

void main() {
    uint workgroup_id = gl_WorkGroupID.x;
    if (workgroup_id >= in_dirty_count) return;

    uint tile_id = dirty_tile_ids[workgroup_id];
    uint col = tile_id % pc.grid_cols;
    uint row = tile_id / pc.grid_cols;

    uint tile_x = col * pc.tile_size;
    uint tile_y = row * pc.tile_size;
    uint tile_w = min(pc.tile_size, pc.width - tile_x);
    uint tile_h = min(pc.tile_size, pc.height - tile_y);

    uint r = gl_LocalInvocationID.x; // Thread index 0..31

    // Step 1: Fully coalesced parallel tile ingestion from global memory to LDS (Bank-padded stride 33)
    uint row_base_offset = tile_y * pc.stride_words + tile_x + r;
    uint gy_stride = pc.stride_words;
    if (r < tile_w) {
        for (uint k = 0; k < tile_h; ++k) {
            s_tile_pixels[k * 33 + r] = curr_pixels[row_base_offset + k * gy_stride];
        }
    } else {
        for (uint k = 0; k < tile_h; ++k) {
            s_tile_pixels[k * 33 + r] = 0u;
        }
    }
    barrier();

    // Step 2: High-speed RLE compression on LDS memory with conflict-free banks
    if (r < tile_h) {
        uint row_words_base = r * 33;
        uint row_bytes = tile_w * 4;
        uint src_idx = 0;

        uint row_buf_base = r * 41;
        uint out_words = 0;
        uint cur_word = 0;
        uint cur_byte_count = 0;

        while (src_idx < row_bytes && (out_words * 4 + cur_byte_count) + 3 < 160) {
            uint w_idx = src_idx >> 2;
            uint cur_w = s_tile_pixels[row_words_base + w_idx];
            uint byte_val = (cur_w >> ((src_idx & 3u) * 8u)) & 0xFFu;
            uint count = 1;

            while (src_idx + count < row_bytes && count < 255) {
                uint next_w_idx = (src_idx + count) >> 2;
                uint nw = (next_w_idx == w_idx) ? cur_w : s_tile_pixels[row_words_base + next_w_idx];
                uint next_byte = (nw >> (((src_idx + count) & 3u) * 8u)) & 0xFFu;
                if (next_byte != byte_val) break;
                count++;
            }

            if (count > 3 || byte_val == 0x55u) {
                if (cur_byte_count == 0u) {
                    cur_word = 0x55u | (count << 8u) | (byte_val << 16u);
                    cur_byte_count = 3u;
                } else if (cur_byte_count == 1u) {
                    cur_word |= (0x55u << 8u) | (count << 16u) | (byte_val << 24u);
                    s_row_comp[row_buf_base + out_words++] = cur_word;
                    cur_word = 0u;
                    cur_byte_count = 0u;
                } else if (cur_byte_count == 2u) {
                    cur_word |= (0x55u << 16u) | (count << 24u);
                    s_row_comp[row_buf_base + out_words++] = cur_word;
                    cur_word = byte_val;
                    cur_byte_count = 1u;
                } else {
                    cur_word |= (0x55u << 24u);
                    s_row_comp[row_buf_base + out_words++] = cur_word;
                    cur_word = count | (byte_val << 8u);
                    cur_byte_count = 2u;
                }
                src_idx += count;
            } else {
                cur_word |= (byte_val << (cur_byte_count * 8u));
                cur_byte_count++;
                if (cur_byte_count == 4u) {
                    s_row_comp[row_buf_base + out_words++] = cur_word;
                    cur_word = 0u;
                    cur_byte_count = 0u;
                }
                src_idx++;
            }
        }

        // Flush remainder word if any
        if (cur_byte_count > 0) {
            s_row_comp[row_buf_base + out_words] = cur_word;
        }
        s_row_len[r] = (out_words * 4) + cur_byte_count;
    } else {
        s_row_len[r] = 0;
    }

    barrier();

    // Step 3: Thread 0 aggregates lengths and reserves packet output position
    if (r == 0) {
        uint total_comp = 0;
        for (uint i = 0; i < tile_h; ++i) {
            s_row_offset[i] = total_comp;
            total_comp += s_row_len[i];
        }

        uint raw_bytes = tile_w * tile_h * 4;
        if (total_comp > 0 && total_comp < (raw_bytes * 85 / 100)) {
            s_comp_type = 1u; // RunLengthDL1
            s_tile_payload_len = total_comp;
        } else {
            s_comp_type = 0u; // RawUncompressed
            s_tile_payload_len = raw_bytes;
        }

        // Reserve 14 bytes for TileDescriptorHeader + payload in output buffer
        s_out_pos = atomicAdd(total_packet_bytes, 14 + s_tile_payload_len);
    }

    barrier();

    // Step 4: Thread 0 writes the 14-byte packed TileDescriptorHeader
    if (r == 0) {
        uint pos = s_out_pos;
        packet_data[pos + 0] = uint8_t(tile_x & 0xFFu);
        packet_data[pos + 1] = uint8_t((tile_x >> 8u) & 0xFFu);
        packet_data[pos + 2] = uint8_t(tile_y & 0xFFu);
        packet_data[pos + 3] = uint8_t((tile_y >> 8u) & 0xFFu);
        packet_data[pos + 4] = uint8_t(tile_w & 0xFFu);
        packet_data[pos + 5] = uint8_t((tile_w >> 8u) & 0xFFu);
        packet_data[pos + 6] = uint8_t(tile_h & 0xFFu);
        packet_data[pos + 7] = uint8_t((tile_h >> 8u) & 0xFFu);
        packet_data[pos + 8] = uint8_t(s_comp_type);
        packet_data[pos + 9] = uint8_t(0x01);
        packet_data[pos + 10] = uint8_t(s_tile_payload_len & 0xFFu);
        packet_data[pos + 11] = uint8_t((s_tile_payload_len >> 8u) & 0xFFu);
        packet_data[pos + 12] = uint8_t((s_tile_payload_len >> 16u) & 0xFFu);
        packet_data[pos + 13] = uint8_t((s_tile_payload_len >> 24u) & 0xFFu);
    }

    // Step 5: High-throughput parallel write of payload across the 32 threads
    if (s_comp_type == 1u) {
        if (r < tile_h) {
            uint dest_base = s_out_pos + 14 + s_row_offset[r];
            uint len = s_row_len[r];
            uint row_buf_base = r * 41;
            uint w_count = len >> 2;
            uint rem = len & 3u;

            for (uint w = 0; w < w_count; ++w) {
                uint word = s_row_comp[row_buf_base + w];
                uint base = dest_base + (w << 2);
                packet_data[base + 0] = uint8_t(word & 0xFFu);
                packet_data[base + 1] = uint8_t((word >> 8u) & 0xFFu);
                packet_data[base + 2] = uint8_t((word >> 16u) & 0xFFu);
                packet_data[base + 3] = uint8_t((word >> 24u) & 0xFFu);
            }
            if (rem > 0) {
                uint word = s_row_comp[row_buf_base + w_count];
                uint base = dest_base + (w_count << 2);
                packet_data[base + 0] = uint8_t(word & 0xFFu);
                if (rem > 1) packet_data[base + 1] = uint8_t((word >> 8u) & 0xFFu);
                if (rem > 2) packet_data[base + 2] = uint8_t((word >> 16u) & 0xFFu);
            }
        }
    } else {
        if (r < tile_h) {
            uint dest_base = s_out_pos + 14 + r * (tile_w * 4);
            uint row_words_base = r * 33;
            for (uint px = 0; px < tile_w; ++px) {
                uint word = s_tile_pixels[row_words_base + px];
                uint base = dest_base + (px << 2);
                packet_data[base + 0] = uint8_t(word & 0xFFu);
                packet_data[base + 1] = uint8_t((word >> 8u) & 0xFFu);
                packet_data[base + 2] = uint8_t((word >> 16u) & 0xFFu);
                packet_data[base + 3] = uint8_t((word >> 24u) & 0xFFu);
            }
        }
    }
}
