#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
    uint src_stride;
    uint dst_y_stride;
    uint dst_uv_stride;
} pc;

layout(std430, binding = 0) readonly buffer InputBuffer {
    uint src_pixels[];
};

layout(std430, binding = 1) writeonly buffer OutputY {
    uint8_t dst_y[];
};

layout(std430, binding = 2) writeonly buffer OutputU {
    uint8_t dst_u[];
};

layout(std430, binding = 3) writeonly buffer OutputV {
    uint8_t dst_v[];
};

void main() {
    uint qx = gl_GlobalInvocationID.x;
    uint qy = gl_GlobalInvocationID.y;
    uint x = qx * 2;
    uint y = qy * 2;

    if (x >= pc.width || y >= pc.height) {
        return;
    }

    uint x1 = min(x + 1, pc.width - 1);
    uint y1 = min(y + 1, pc.height - 1);

    uint src_stride_words = pc.src_stride >> 2;
    uint p00 = src_pixels[y * src_stride_words + x];
    uint p10 = src_pixels[y * src_stride_words + x1];
    uint p01 = src_pixels[y1 * src_stride_words + x];
    uint p11 = src_pixels[y1 * src_stride_words + x1];

    int b00 = int(p00 & 0xFFu);
    int g00 = int((p00 >> 8u) & 0xFFu);
    int r00 = int((p00 >> 16u) & 0xFFu);

    int b10 = int(p10 & 0xFFu);
    int g10 = int((p10 >> 8u) & 0xFFu);
    int r10 = int((p10 >> 16u) & 0xFFu);

    int b01 = int(p01 & 0xFFu);
    int g01 = int((p01 >> 8u) & 0xFFu);
    int r01 = int((p01 >> 16u) & 0xFFu);

    int b11 = int(p11 & 0xFFu);
    int g11 = int((p11 >> 8u) & 0xFFu);
    int r11 = int((p11 >> 16u) & 0xFFu);

    int y00 = ((66 * r00 + 129 * g00 + 25 * b00 + 128) >> 8) + 16;
    int y10 = ((66 * r10 + 129 * g10 + 25 * b10 + 128) >> 8) + 16;
    int y01 = ((66 * r01 + 129 * g01 + 25 * b01 + 128) >> 8) + 16;
    int y11 = ((66 * r11 + 129 * g11 + 25 * b11 + 128) >> 8) + 16;

    dst_y[y * pc.dst_y_stride + x] = uint8_t(clamp(y00, 0, 255));
    if (x + 1 < pc.width) {
        dst_y[y * pc.dst_y_stride + x + 1] = uint8_t(clamp(y10, 0, 255));
    }
    if (y + 1 < pc.height) {
        dst_y[(y + 1) * pc.dst_y_stride + x] = uint8_t(clamp(y01, 0, 255));
        if (x + 1 < pc.width) {
            dst_y[(y + 1) * pc.dst_y_stride + x + 1] = uint8_t(clamp(y11, 0, 255));
        }
    }

    int u = ((-38 * r00 - 74 * g00 + 112 * b00 + 128) >> 8) + 128;
    int v = ((112 * r00 - 94 * g00 - 18 * b00 + 128) >> 8) + 128;

    dst_u[qy * pc.dst_uv_stride + qx] = uint8_t(clamp(u, 0, 255));
    dst_v[qy * pc.dst_uv_stride + qx] = uint8_t(clamp(v, 0, 255));
}
